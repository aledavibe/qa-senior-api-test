{
	"info": {
		"name": "JSONPlaceholder_API",
		"description": "Coleção para avaliação QA Sênior - Finaya",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "GET All Posts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1. Validar Status Code 200 ",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// 2. Validar que o retorno é uma lista e não está vazia",
							"pm.test(\"Response is an array with items\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.above(0);",
							"});",
							"",
							"// 3. Validar campos obrigatórios e tipos no primeiro item ",
							"pm.test(\"Validate object structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    var post = jsonData[0];",
							"    ",
							"    pm.expect(post).to.have.property('userId').that.is.a('number');",
							"    pm.expect(post).to.have.property('id').that.is.a('number');",
							"    pm.expect(post).to.have.property('title').that.is.a('string');",
							"    pm.expect(post).to.have.property('body').that.is.a('string');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/posts",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"posts"
					]
				}
			}
		},
		{
			"name": "GET Post by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1. Validar Status Code 200 ",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Capturar resposta",
							"var jsonData = pm.response.json();",
							"",
							"// 2. Validar valor do campo ID conforme variável de ambiente ",
							"pm.test(\"Check if ID matches environment variable\", function () {",
							"    var envId = parseInt(pm.environment.get(\"postid\"));",
							"    pm.expect(jsonData.id).to.eql(envId);",
							"});",
							"",
							"// 3. Validar tipos dos campos e obrigatoriedade ",
							"pm.test(\"Validate field types\", function () {",
							"    pm.expect(jsonData.userId).to.be.a('number');",
							"    pm.expect(jsonData.title).to.be.a('string');",
							"    pm.expect(jsonData.body).to.be.a('string');",
							"});",
							"",
							"// 4. Validar que campos não são nulos/vazios",
							"pm.test(\"Validate content is present\", function () {",
							"    pm.expect(jsonData.title).to.not.be.empty;",
							"    pm.expect(jsonData.body).to.not.be.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/posts/{{postid}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"posts",
						"{{postid}}"
					]
				}
			}
		}
	]
}